{
  "explorer.compactFolders": false,
  "workbench.colorTheme": "Default Dark Modern",
  "go.toolsManagement.autoUpdate": true,
  "vim.easymotion": true,
  "vim.easymotionKeys": "hklyuiopnm,qwertzxcvbasdgjf",
  "vim.easymotionMarkerForegroundColorTwoCharFirst": "#d700e5",
  "vim.easymotionMarkerForegroundColorTwoCharSecond": "#d700e5",
  "vim.easymotionMarkerForegroundColorOneChar": "#d700e5",
  "vim.easymotionDimBackground": false,
  "vim.useSystemClipboard": true,
  "vim.camelCaseMotion.enable": true,
  "vim.leader": "<tab>",
  "vim.startInInsertMode": false,
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [" "],
      "after": ["leader", "leader", "leader", "b", "d", "w"],
    },
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"],
    },
    {
      "before": ["g", "n"],
      "commands": ["editor.action.rename"],
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"],
    },
    {
      "before": ["g", "e"],
      "commands": ["workbench.action.navigateToLastEditLocation"],
    },
    {
      "before": ["g", "p"],
      "commands": ["editor.action.triggerParameterHints"],
    },
    {
      "before": ["g", "m"],
      "commands": ["editor.action.marker.next"],
    },
    {
      "before": ["g", "t"],
      "commands": ["go.test.cursorOrPrevious"],
    },
  ],
  "editor.smoothScrolling": true,
  "cursor.cpp.disabledLanguages": [],
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "go": true
  },
}
